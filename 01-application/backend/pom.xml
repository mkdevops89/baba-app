<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.babaapp</groupId>
	<artifactId>baba-app-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Baba App Backend</name>
	<description>Backend service for Baba App</description>
	<properties>
		<java.version>17</java.version>

		<!--
		    Temporary security overrides for versions that are newer than those
		    managed by Spring Boot 4.0.8. Remove each override after the Spring Boot
		    BOM manages an equal or newer patched release.
	    -->
	    <tomcat.version>11.0.25</tomcat.version>
	    <jackson-bom.version>3.1.7</jackson-bom.version>

	    <!--
		    Preserve the previously validated Log4j release until Spring Boot manages
		    an equal or newer version and the container scan confirms it is clean.
	    -->
        <log4j2.version>2.25.5</log4j2.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
	       Spring Boot 4 separates Spring MVC into its dedicated starter. This REST
	       application uses the servlet stack and does not require Spring WebFlux.
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			Spring Boot 4 separates MVC test auto-configuration into a dedicated
			module. This dependency provides @AutoConfigureMockMvc and the test
			infrastructure needed to exercise the real MVC and security filters.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Provide Spring Security test utilities for authenticated and
			unauthenticated request validation. The current tests exercise the
			real SecurityFilterChain without creating production credentials.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Exposes production-ready application health and management endpoints. -->
		<!-- Only the minimum required endpoints will be enabled in configuration. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Bridges Spring Boot Micrometer metrics into Prometheus format so the -->
		<!-- EKS observability stack can scrape JVM and HTTP application metrics. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
