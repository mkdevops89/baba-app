SERVER_PORT=8080
BABAAPP_CORS_ALLOWED_ORIGIN=http://localhost:3000

# H2 is the Phase 01 default. Override these only when testing MySQL.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/babaapp
# SPRING_DATASOURCE_USERNAME=babaapp
# SPRING_DATASOURCE_PASSWORD=change-me
# SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_SSL_ENABLED=false
