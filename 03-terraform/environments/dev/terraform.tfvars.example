project_name = "baba-app"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

# Synthetic documentation value used by CI security scans.
# Real administrative source CIDRs belong in the ignored terraform.tfvars file.
cluster_public_access_cidrs = [
  "203.0.113.10/32"
]

# -----------------------------------------------------------------------------
# EKS Lifecycle
# -----------------------------------------------------------------------------
# Set to true when the development Kubernetes runtime is intentionally needed.
# Keep false when EKS is not in use to avoid unnecessary cluster and node costs.
enable_eks = false
